# Node Environment
NODE_ENV=development
PORT=5000

# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aquaflow_db?schema=public"

# Redis Cache & BullMQ Queue Connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets & Expiration
JWT_ACCESS_SECRET="aquaflow_super_secret_access_jwt_key_change_in_production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="aquaflow_super_secret_refresh_jwt_key_change_in_production"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS Allowed Origins
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# Cloudinary / Storage (Optional for asset uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

