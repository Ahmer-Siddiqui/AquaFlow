{
  "name": "aquaflow-backend",
  "version": "1.0.0",
  "description": "Multi-Tenant Water Supply and Distribution Management SaaS Platform Backend",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typeorm": "typeorm",
    "migration:run": "typeorm migration:run -d dist/config/data-source.js",
    "migration:revert": "typeorm migration:revert -d dist/config/data-source.js",
    "migration:show": "typeorm migration:show -d dist/config/data-source.js",
    "db:migrate": "node dist/scripts/migrate.js",
    "db:revert": "node dist/scripts/revert-migration.js",
    "db:fresh": "node dist/scripts/revert-all.js && node dist/scripts/migrate.js && node dist/scripts/seeds/seed-all.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "seed:user-types": "node dist/scripts/seeds/seed-user-types.js",
    "seed:roles": "node dist/scripts/seeds/seed-roles.js",
    "seed:permissions": "node dist/scripts/seeds/seed-permissions.js",
    "seed:employment-types": "node dist/scripts/seeds/seed-employment-types.js",
    "seed:all": "node dist/scripts/seeds/seed-all.js",
    "graph:update": "python -m graphify update \"..\"",
    "graph:watch": "python -m graphify watch \"..\""
  },
  "dependencies": {
    "argon2": "^0.40.1",
    "bullmq": "^5.7.9",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.7.5",
    "swagger-ui-express": "^5.0.0",
    "typeorm": "^1.1.2",
    "yamljs": "^0.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.12.12",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/yamljs": "^0.2.34",
    "supertest": "^7.0.0",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
